    "page/loader.js",
    "ui/actions.js",
    "ui/app.js",
    "ui/bridge.js",
    "ui/controls.js",
    "ui/index.html",
    "ui/models.js",
    "ui/quota.js",
    "ui/recovery.js",
    "ui/settings-scope.js",
    "ui/settings.css",
    "ui/settings.js",
    "ui/style.css",
    "ui/icons/",
    "README.md",
    "native-models.mjs",
    "magpie-agent-reader.mjs",
    "native-icons.json",
    "model-parameters.mjs",
    "LICENSE",
    "MAGPIE-LICENSE",
    "validation-cache.mjs",
    "settings-catalog.mjs"
