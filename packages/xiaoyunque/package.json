{
  "name": "@magpie-community/opencode-xiaoyunque-auth",
  "version": "0.1.0",
  "description": "小云雀图片和视频供应商：网页登录或 Access Key、动态模型、积分和媒体生成",
  "repository": { "type": "git", "url": "git+https://github.com/magpie-community/plugins.git", "directory": "packages/xiaoyunque" },
  "type": "module",
  "main": "./opencode.mjs",
  "exports": {
    "./server": "./index.mjs",
    ".": "./opencode2.mjs"
  },
  "files": [
    "index.mjs",
    "opencode.mjs",
    "opencode2.mjs",
    "api.mjs",
    "auth.mjs",
    "media.mjs",
    "tools.mjs",
    "delivery.mjs",
    "icons/xiaoyunque.svg",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test *.test.mjs",
    "check": "node --check index.mjs && node --check opencode.mjs && node --check opencode2.mjs && node --check api.mjs && node --check auth.mjs && node --check media.mjs && node --check tools.mjs && node --check delivery.mjs"
  },
  "engines": { "node": ">=22" },
  "keywords": ["magpie", "magpie-plugin", "opencode", "xiaoyunque", "pippit", "image", "video"],
  "magpie": {
    "name": "小云雀",
    "maxConcurrency": 4,
    "icon": "data:image/svg+xml;base64,"
  },
  "license": "MIT"
}
