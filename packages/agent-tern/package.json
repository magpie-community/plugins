{
  "name": "@magpie-community/agent-tern",
  "version": "0.1.0",
  "description": "Tern for magpie: pick a magpie model on the Agents page and Tern's built-in omp agent uses it, with the gateway provider and start-up config written for you",
  "type": "module",
  "main": "./sync.mjs",
  "files": [
    "tern.agent.js",
    "sync.mjs",
    "README.md",
    "INSTALL.md",
    "LICENSE"
  ],
  "keywords": [
    "magpie",
    "magpie-agent",
    "tern",
    "omp",
    "oh-my-pi",
    "magpie-plugin"
  ],
  "license": "MIT",
  "author": "magpie-plugin-tern contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/magpie-community/plugins.git",
    "directory": "packages/agent-tern"
  },
  "homepage": "https://github.com/magpie-community/plugins/tree/main/packages/agent-tern#readme",
  "bugs": {
    "url": "https://github.com/magpie-community/plugins/issues"
  },
  "scripts": {
    "test": "bun test"
  },
  "publishConfig": {
    "access": "public"
  },
  "magpie": {
    "kind": "agent",
    "agent": "./tern.agent.js",
    "name": "Tern",
    "icon": "data:image/svg+xml;base64,",
    "summary": {
      "en": "Add Tern to magpie's Agents page; Tern's built-in agent is omp, and the model picked in magpie is written to omp's models.yml and config.yml",
      "zh": "把 Tern 加到 magpie 的 Agents 页；Tern 的 agent 是 omp，magpie 选的模型写入 omp 的 models.yml 和 config.yml"
    }
  }
}
