{
  "name": "@magpie-community/page-usage-tree",
  "version": "0.1.0",
  "description": "A page in magpie's window: usage as provider -> account -> model, each level expandable, with calls, tokens and cost. Reads your local usage ledger only.",
  "type": "module",
  "main": "./index.mjs",
  "files": [
    "index.mjs",
    "serve.mjs",
    "lib",
    "page",
    "ui",
    "assets",
    "LICENSE",
    "README.md",
    "PUBLISHING.md"
  ],
  "scripts": {
    "start": "node serve.mjs",
    "test": "node --test test/*.test.mjs"
  },
  "engines": {
    "magpie": ">=0.1.1340"
  },
  "keywords": [
    "magpie",
    "magpie-page",
    "magpie-plugin",
    "usage",
    "accounts",
    "models",
    "tokens",
    "cost"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/magpie-community/plugins.git",
    "directory": "packages/page-usage-tree"
  },
  "homepage": "https://github.com/magpie-community/plugins/tree/main/packages/page-usage-tree",
  "bugs": {
    "url": "https://github.com/magpie-community/plugins/issues"
  },
  "magpie": {
    "page": {
      "title": "Account usage",
      "titles": {
        "zh": "账号用量",
        "zh-TW": "帳號用量",
        "ja": "アカウント使用量",
        "de": "Kontonutzung"
      },
      "file": "page/index.html",
      "service": {
        "port": 3488,
        "option": "port"
      },
      "icon": "page/icon.svg"
    },
    "options": {
      "port": 3488,
      "usdCny": 7.2
    },
    "icon": "data:image/svg+xml;base64,"
  }
}
