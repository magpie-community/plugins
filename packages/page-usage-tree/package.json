{
  "name": "@magpie-community/page-usage-tree",
  "version": "0.1.0",
  "description": "在 Magpie 窗口中按供应商 -> 账号 -> 模型查看用量，逐级展开调用、错误、Token 与费用。A page in Magpie's window: usage as provider -> account -> model, each level expandable, with calls, errors, tokens and cost from Magpie's local usage API.",
  "type": "module",
  "main": "./index.mjs",
  "files": [
    "index.mjs",
    "serve.mjs",
    "lib",
    "page",
    "ui",
    "assets",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "start": "node serve.mjs",
    "test": "node --test test/*.test.mjs"
  },
  "engines": {
    "magpie": ">=0.1.1340"
  },
  "keywords": [
    "magpie",
    "magpie-page",
    "magpie-plugin",
    "usage",
    "accounts",
    "models",
    "tokens",
    "cost"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/magpie-community/plugins.git",
    "directory": "packages/page-usage-tree"
  },
  "homepage": "https://github.com/magpie-community/plugins/tree/main/packages/page-usage-tree",
  "bugs": {
    "url": "https://github.com/magpie-community/plugins/issues"
  },
  "magpie": {
    "name": "账号用量 / Account usage",
    "summary": {
      "en": "A provider -> account -> model usage tree with per-account calls, errors, tokens and cost. Adds the account layer that Usage Glance's usage:summary does not contain, read from Magpie's local usage API.",
      "zh": "按供应商 -> 账号 -> 模型查看用量，逐级展开调用、错误、Token 与费用。补充用量速览没有的账号层，数据来自 Magpie 本地用量 API。"
    },
    "page": {
      "title": "Account usage",
      "titles": {
        "en": "Account usage",
        "zh": "账号用量"
      },
      "file": "page/index.html",
      "service": {
        "port": 3494,
        "option": "port"
      },
      "icon": "page/icon.svg"
    },
    "options": {
      "port": 3494,
      "currency": "usd",
      "chineseUnits": false,
      "usdCny": 0
    },
    "icon": "data:image/svg+xml;base64,"
  }
}
