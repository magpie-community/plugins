{
  "name": "@magpie-community/middleware-output-strategy",
  "version": "0.2.2",
  "description": "Composable output-style instructions injected before the model call, with a small selection panel",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/magpie-community/plugins.git",
    "directory": "packages/output-strategy"
  },
  "files": [
    "output-strategy.middleware.js",
    "apply.js",
    "catalog.js",
    "scripts/gen-page-catalog.mjs",
    "page/*.html",
    "page/*.js",
    "page/*.css",
    "README.md",
    "LICENSE",
    "PROVENANCE.json",
    "LICENSES/"
  ],
  "keywords": ["magpie", "magpie-middleware", "output-styles", "prompt"],
  "magpie": {
    "middleware": "./output-strategy.middleware.js",
    "page": {
      "title": "Output Strategy",
      "titles": { "zh": "输出策略" },
      "file": "page/index.html"
    },
    "options": {
      "styles": {
        "terse-prose": false,
        "less-code": false,
        "ponytail": false,
        "i-have-adhd": false,
        "terse-cjk": false,
        "antislop-ui": false,
        "antislop-copy": false
      }
    }
  },
  "scripts": {
    "build:catalog": "node scripts/gen-page-catalog.mjs",
    "test": "bun test"
  }
}
