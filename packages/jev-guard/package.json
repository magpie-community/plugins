{
  "name": "@magpie-community/middleware-jev-guard",
  "version": "0.1.0",
  "description": "Jev System One (TypeSafe) quality & guardrail gatekeeper as magpie gateway middleware",
  "type": "module",
  "files": [
    "jev-guard.middleware.js",
    "README.md"
  ],
  "keywords": [
    "magpie",
    "magpie-middleware",
    "typesafe",
    "jev",
    "systemone",
    "guardrails",
    "llm-gateway"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/magpie-community/plugins.git",
    "directory": "packages/jev-guard"
  },
  "magpie": {
    "middleware": "./jev-guard.middleware.js",
    "options": {
      "blocked_patterns": [
        "__FORCE_MALICIOUS_CRASH__"
      ],
      "reject_message": "Jev Gate: High-risk instruction pattern blocked by System One policy."
    }
  }
}
