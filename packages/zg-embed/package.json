{
  "name": "@magpie-community/opencode-zg-embed-auth",
  "version": "0.2.0",
  "description": "Routes every embedding name zvec-grep (zg) hardcodes to one configured upstream model (Bailian/DashScope flash by default) in OpenCode and magpie, with protocol auto-adaptation; your API key, public or workspace endpoint",
  "type": "module",
  "main": "./opencode.mjs",
  "exports": { ".": "./opencode2.mjs" },
  "files": [
    "index.mjs",
    "opencode.mjs",
    "opencode2.mjs",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "opencode",
    "opencode-plugin",
    "magpie",
    "embedding",
    "dashscope",
    "bailian",
    "zvec-grep"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/magpie-community/plugins",
    "directory": "packages/zg-embed"
  },
  "scripts": {
    "test": "bun test"
  },
  "magpie": {
    "options": {
      "endpoint": "https://dashscope.aliyuncs.com/compatible-mode/v1",
      "model": "qwen3.7-text-embedding-flash"
    },
    "maxConcurrency": 4
  }
}