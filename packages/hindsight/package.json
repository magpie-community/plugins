{
  "name": "@magpie-community/gateway-hindsight",
  "version": "0.1.0",
  "description": "Automatic Hindsight memory recall and opt-in conversation capture for Magpie asynchronous gateway hooks.",
  "type": "module",
  "license": "Apache-2.0",
  "author": "Sam-dancing-nu1",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/magpie-community/plugins.git",
    "directory": "packages/hindsight"
  },
  "homepage": "https://github.com/magpie-community/plugins/tree/main/packages/hindsight",
  "bugs": {
    "url": "https://github.com/magpie-community/plugins/issues"
  },
  "keywords": [
    "magpie-plugin",
    "magpie",
    "hindsight",
    "memory",
    "gateway"
  ],
  "engines": {
    "node": ">=22",
    "bun": ">=1.3.8"
  },
  "files": [
    "hooks.mjs",
    "lib/",
    "README.md",
    "LICENSE",
    "page"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "check": "node scripts/check.mjs"
  },
  "magpie": {
    "name": "Hindsight Memory",
    "hooks": "./hooks.mjs",
    "options": {
      "hindsight_api": "http://127.0.0.1:8888",
      "bank": "hermes",
      "recall_max_tokens": 1024,
      "capture": false,
      "agents": [],
      "gatewayTimeoutMs": 5000,
      "port": 3482
    },
    "page": {
      "title": "Hindsight Memory",
      "file": "page/settings.html",
      "icon": "page/icon.svg",
      "service": {
        "port": 3482,
        "option": "port"
      }
    }
  },
  "main": "./page/service.mjs"
}