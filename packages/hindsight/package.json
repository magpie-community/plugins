{
  "name": "@magpie-community/gateway-hindsight",
  "version": "0.1.0",
  "description": "Automatic Hindsight memory recall and opt-in conversation capture for Magpie asynchronous gateway hooks.",
  "type": "module",
  "license": "Apache-2.0",
  "keywords": [
    "magpie-plugin",
    "magpie",
    "hindsight",
    "memory",
    "gateway"
  ],
  "engines": {
    "node": ">=22",
    "bun": ">=1.3.8"
  },
  "files": [
    "index.js",
    "hooks.mjs",
    "lib/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "check": "node scripts/check.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/magpie-community/plugins.git",
    "directory": "packages/hindsight"
  },
  "magpie": {
    "name": "Hindsight Memory",
    "hooks": "./hooks.mjs",
    "options": {
      "hindsight_api": "http://127.0.0.1:8888",
      "bank": "hermes",
      "recall_max_tokens": 1024,
      "capture": false,
      "agents": [],
      "gatewayTimeoutMs": 5000
    }
  }
}
