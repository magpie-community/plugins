{
  "name": "@magpie-community/gateway-hindsight",
  "version": "1.0.0",
  "description": "Recall from your own Hindsight before each request and capture completed turns on demand, for Magpie's asynchronous gateway hooks",
  "type": "module",
  "license": "MIT AND Apache-2.0",
  "author": "zysicyj",
  "contributors": [
    "Sam-dancing-nu1 (original author of github.com/Sam-dancing-nu1/magpie-hindsight)"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/magpie-community/plugins.git",
    "directory": "packages/hindsight"
  },
  "homepage": "https://github.com/zysicyj/magpie-hindsight#readme",
  "bugs": {
    "url": "https://github.com/zysicyj/magpie-hindsight/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "magpie",
    "magpie-gateway",
    "hindsight",
    "memory",
    "llm-gateway"
  ],
  "engines": {
    "node": ">=22",
    "bun": ">=1.3.8"
  },
  "files": [
    "hooks.mjs",
    "lib/",
    "README.md",
    "LICENSE",
    "LICENSE-APACHE",
    "NOTICE",
    "page"
  ],
  "main": "./page/service.mjs",
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "check": "node scripts/check.mjs"
  },
  "magpie": {
    "name": "Hindsight Memory",
    "hooks": "./hooks.mjs",
    "options": {
      "hindsight_api": "http://127.0.0.1:8888",
      "bank": "hermes",
      "recall_max_tokens": 1024,
      "capture": false,
      "agents": [],
      "gatewayTimeoutMs": 5000,
      "api_key": "",
      "api_key_header": "Authorization",
      "api_key_prefix": "Bearer ",
      "authorizationEnv": "",
      "max_replay_blocks": 8,
      "port": 3482
    },
    "page": {
      "title": "Hindsight Memory",
      "file": "page/settings.html",
      "icon": "page/icon.svg",
      "service": {
        "port": 3482,
        "option": "port"
      }
    },
    "icon": "data:image/svg+xml;base64,"
  }
}
