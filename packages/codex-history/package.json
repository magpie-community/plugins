{
  "name": "@magpie-community/middleware-codex-history",
  "version": "0.2.1",
  "description": "Unified Magpie Codex workbench: history compatibility, optional model checks and protection",
  "type": "module",
  "license": "MIT",
  "main": "./plugin/index.mjs",
  "files": [
    "plugin",
    "server",
    "web",
    "history",
    "vendor",
    "workbench.middleware.js",
    "Open.bat",
    "tools",
    "docs/images",
    "README.md",
    "LICENSE",
    "PROVENANCE.json",
    "codex-history.middleware.js",
    "Diagnose.bat",
    "docs/USAGE.md",
    "docs/RELEASE-v0.2.1.md",
    "MAINTAINING.md"
  ],
  "keywords": [
    "magpie",
    "magpie-middleware",
    "codex",
    "responses",
    "history"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/magpie-community/plugins.git",
    "directory": "packages/codex-history"
  },
  "bugs": {
    "url": "https://github.com/unisong/magpie-codex-history-filter/issues"
  },
  "scripts": {
    "build": "node tools/build-middleware.mjs",
    "prepack": "npm run build",
    "test": "node --test test/*.test.mjs",
    "start": "node tools/open.mjs"
  },
  "magpie": {
    "middleware": "./workbench.middleware.js",
    "page": {
      "title": "Codex Workbench · 历史过滤",
      "file": "history/page/index.html",
      "icon": "history/page/icon.svg"
    },
    "permissions": [
      "providers:list"
    ],
    "options": {
      "providers": {},
      "aliases": {}
    }
  }
}
