{
  "name": "@magpie-community/middleware-multi-path-router",
  "version": "0.1.0",
  "description": "3D orthogonal token router for multi-agent workloads: discriminator-driven intent classification, physical constraint gating (vision/context), and dynamic cost/schedule arbitrage",
  "type": "module",
  "files": [
    "multi-path-router.middleware.js",
    "README.md",
    "sankey.html"
  ],
  "keywords": [
    "magpie",
    "magpie-middleware",
    "router",
    "multi-path",
    "system-one",
    "cost-optimization",
    "load-balancing",
    "llm-gateway"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/magpie-community/plugins.git",
    "directory": "packages/multi-path-router"
  },
  "magpie": {
    "middleware": "./multi-path-router.middleware.js",
    "options": {
      "schedule": {
        "cst_deepseek_offpeak": true,
        "offpeak_mapping": {
          "smart-router": "group/tier-dynamic-value"
        }
      },
      "constraints": {
        "vision": "group/tier-multimodal-runtime",
        "tokens_gte": {
          "threshold": 64000,
          "target": "group/tier-extended-context"
        }
      },
      "mapping": {
        "smart-router": "group/tier-fast-reflex"
      }
    }
  }
}
