  {
    "name": "image in request triggers vision constraint gate",
    "options": {
      "constraints": {
        "vision": "local-qwen/Qwen3.8-27B"
      },
      "mapping": {
        "smart-router": "deepseek/deepseek-chat"
      }
    },
    "request": {
      "model": "smart-router",
      "messages": [
        {
          "role": "user",
          "content": [
            {
              "type": "text",
              "text": "inspect this screenshot"
            },
            {
              "type": "image",
              "source": {
                "type": "base64",
                "data": "abc"
              }
            }
          ]
        }
      ]
    },
    "expect_request": {
      "model": "local-qwen/Qwen3.8-27B",
      "messages": [
        {
          "role": "user",
          "content": [
            {
              "type": "text",
              "text": "inspect this screenshot"
            },
            {
              "type": "image",
              "source": {
                "type": "base64",
                "data": "abc"
              }
            }
          ]
        }
      ]
    }
  },
  {
