  {
    "name": "image in request triggers vision constraint gate",
    "options": {
      "constraints": {
        "vision": "local-qwen/Qwen3.8-27B"
      },
      "mapping": {
        "smart-router": "deepseek/deepseek-chat"
      }
    },
    "request": {
      "model": "smart-router",
      "messages": [
        {
          "role": "user",
          "content": [
            { "type": "text", "text": "inspect this screenshot" },
            { "type": "image", "source": { "type": "base64", "data": "abc" } }
          ]
        }
      ]
    },
    "expect_request": {
      "model": "local-qwen/Qwen3.8-27B",
      "messages": [
        {
          "role": "user",
          "content": [
            { "type": "text", "text": "inspect this screenshot" },
            { "type": "image", "source": { "type": "base64", "data": "abc" } }
          ]
        }
      ]
    }
  },
  {
    "name": "large token count triggers long context constraint gate",
    "options": {
      "constraints": {
        "tokens_gte": {
          "threshold": 100,
          "target": "grok/grok-4.7@500k"
        }
      },
      "mapping": {
        "smart-router": "deepseek/deepseek-chat"
      }
    },
    "request": {
      "model": "smart-router",
      "messages": [
        {
          "role": "user",
          "content": "A very long document context text with lots of characters. A very long document context text with lots of characters. A very long document context text with lots of characters. A very long document context text with lots of characters. A very long document context text with lots of characters. A very long document context text with lots of characters. A very long document context text with lots of characters. A very long document context text with lots of characters."
        }
      ]
    },
    "expect_request": {
      "model": "grok/grok-4.7@500k",
      "messages": [
        {
          "role": "user",
          "content": "A very long document context text with lots of characters. A very long document context text with lots of characters. A very long document context text with lots of characters. A very long document context text with lots of characters. A very long document context text with lots of characters. A very long document context text with lots of characters. A very long document context text with lots of characters. A very long document context text with lots of characters."
        }
      ]
    }
  },
  {
    "name": "replies restore the asked model name",
    "options": {
      "mapping": {
        "smart-router": "deepseek/deepseek-reasoner"
      }
    },
    "request": { "model": "smart-router", "messages": [] },
    "expect_request": { "model": "deepseek/deepseek-reasoner", "messages": [] },
    "response": { "model": "deepseek/deepseek-reasoner", "choices": [{ "message": { "content": "done" } }] },
    "expect_response": { "model": "smart-router", "choices": [{ "message": { "content": "done" } }] }
  }
