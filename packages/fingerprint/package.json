{
  "name": "@magpie-community/page-fingerprint",
  "version": "0.2.2",
  "description": "Check for suspected model substitution with numeric response fingerprints in Magpie, powered by lm-detector.",
  "type": "module",
  "license": "MIT",
  "main": "dist/plugin.js",
  "files": [
    "dist",
    "page",
    "README.md",
    "README.zh-CN.md",
    "LICENSE",
    "integration.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "engines": {
    "bun": ">=1.4.2"
  },
  "scripts": {
    "dev": "bun --watch src/cli.ts",
    "start": "bun src/cli.ts",
    "build": "bun scripts/build.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "check": "bun run typecheck && bun run test && bun run build",
    "format": "prettier --write src web scripts tests page *.json *.ts *.md",
    "rebuild": "bun scripts/rebuild.ts"
  },
  "magpie": {
    "page": {
      "title": "Fingerprint",
      "titles": {
        "zh": "模型指纹",
        "zh-TW": "模型指紋",
        "ja": "モデル指紋",
        "de": "Modell-Fingerabdruck"
      },
      "file": "page/index.html",
      "service": {
        "port": 3488,
        "option": "port"
      }
    },
    "actions": [
      {
        "id": "fingerprint",
        "menu": "provider",
        "title": "Fingerprint",
        "titles": {
          "zh": "检测指纹",
          "zh-TW": "檢測指紋",
          "ja": "指紋を検査",
          "de": "Fingerabdruck prüfen"
        }
      }
    ],
    "options": {
      "port": 3488
    },
    "permissions": []
  },
  "devDependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "@phosphor-icons/react": "2.1.10",
    "@types/bun": "1.4.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "vite": "7.3.7"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/magpie-community/plugins.git",
    "directory": "packages/fingerprint"
  },
  "bugs": {
    "url": "https://github.com/magpie-community/plugins/issues"
  },
  "author": "KaranocaVe (https://github.com/KaranocaVe)",
  "homepage": "https://github.com/KaranocaVe/magpie-fingerprint#readme",
  "keywords": [
    "magpie",
    "magpie-page",
    "magpie-plugin",
    "llm",
    "fingerprint",
    "model-detection"
  ],
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "bun@1.4.4"
}
