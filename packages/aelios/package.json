{
  "name": "@magpie-community/gateway-aelios",
  "version": "0.1.0",
  "description": "Aelios long-term memory for every agent behind magpie: recall before each turn, optional recording after it",
  "type": "module",
  "files": [
    "aelios.hooks.mjs",
    "slim.mjs",
    "service.mjs",
    "probe.mjs",
    "page",
    "README.md"
  ],
  "keywords": [
    "magpie",
    "magpie-gateway",
    "aelios",
    "memory",
    "llm-gateway"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/magpie-community/plugins.git",
    "directory": "packages/aelios"
  },
  "magpie": {
    "hooks": "./aelios.hooks.mjs",
    "options": {
      "apiKeyEnv": "AELIOS_API_KEY",
      "gatewayTimeoutMs": 5000,
      "requestTimeoutMs": 4000,
      "recallBackoffMs": 30000,
      "record": false,
      "port": 3481
    },
    "page": {
      "title": "Aelios",
      "file": "page/settings.html",
      "icon": "page/icon.svg",
      "service": { "port": 3481, "option": "port" }
    }
  },
  "main": "./service.mjs",
  "scripts": {
    "check": "bun test ./*.test.mjs"
  },
  "engines": {
    "bun": ">=1.4.2"
  }
}
