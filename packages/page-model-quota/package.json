  "files": [
    "index.mjs",
    "serve.mjs",
    "lib",
    "page",
    "ui",
    "assets",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "start": "node serve.mjs",
    "test": "node --test test/*.test.mjs"
  },
  "engines": {
    "magpie": ">=0.1.1340"
  },
  "keywords": [
    "magpie",
    "magpie-page",
    "magpie-plugin",
    "quota",
    "usage",
    "tokens",
    "models"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/magpie-community/plugins.git",
    "directory": "packages/page-model-quota"
  },
  "homepage": "https://github.com/magpie-community/plugins/tree/main/packages/page-model-quota",
  "bugs": {
    "url": "https://github.com/magpie-community/plugins/issues"
  },
  "magpie": {
    "name": "Model Quota",
    "summary": {
      "en": "How many tokens each model has left, merged across every account and provider: each quota window is turned into tokens from your own usage history and split by the model's share in it.",
      "zh": "每个模型在所有账号、所有供应商的池子里还剩多少 token：用你自己的用量历史把每个额度窗口换算成 token，再按模型在窗口里的占比摊开。"
    },
    "page": {
      "title": "Model Quota",
      "titles": {
        "en": "Model Quota",
        "zh": "模型剩余额度",
        "zh-TW": "模型剩餘額度"
      },
      "file": "page/index.html",
      "icon": "page/icon.svg",
      "service": {
        "port": 3496,
        "option": "port"
      }
    },
    "options": {
