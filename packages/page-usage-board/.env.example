# Copy to .env (Docker Compose reads it automatically).

# magpie's config directory on the host (contains usage.jsonl). Required for data —
# the path MUST exist on this host, otherwise the mount is empty and the board shows no data.
MAGPIE_CONFIG=/path/to/magpie/config/magpie

# The public name your reverse proxy sends in Host. Required when PAGE_KEY is empty.
ALLOWED_HOSTS=dash.example.com

# Empty: the proxy is the gate (Mode A, recommended for public hosts).
# Set a random value: the app checks it and you open /?key=... once (Mode B).
PAGE_KEY=

# Optional: magpie's gateway bearer key (live quotas/KPIs).
MAGPIE_KEY=
