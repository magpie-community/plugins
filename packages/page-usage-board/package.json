{
  "name": "@magpie-community/page-usage-board",
  "version": "0.1.0",
  "description": "在 magpie 窗口里查看用量：额度到期卡片墙 + 每日/模型/provider 用量图表 + 可选远端归因，由插件自带的本机服务供数。A usage dashboard page in magpie's window: quota cards with expiry tiers, daily and per-provider charts, optional remote attribution, served by the plugin's own local service.",
  "type": "module",
  "main": "./index.mjs",
  "files": [
    "index.mjs",
    "server.mjs",
    "page",
    "static",
    "LICENSE",
    "README.md",
    "scripts",
    "NOTICE",
    "docs",
    "LICENSES"
  ],
  "scripts": {
    "start": "node server.mjs",
    "test": "node --test",
    "prepack": "node scripts/prepack.mjs"
  },
  "engines": {
    "node": ">=22",
    "magpie": ">=0.1.1340"
  },
  "keywords": [
    "magpie",
    "magpie-page",
    "magpie-plugin",
    "usage",
    "dashboard",
    "quota",
    "charts",
    "token"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/magpie-community/plugins.git",
    "directory": "packages/page-usage-board"
  },
  "homepage": "https://github.com/magpie-community/plugins/tree/main/packages/page-usage-board",
  "bugs": {
    "url": "https://github.com/magpie-community/plugins/issues"
  },
  "magpie": {
    "name": "Usage Board",
    "summary": {
      "en": "A quota card wall with expiry tiers, daily/per-provider charts, 24h cache-hit and token curves, optional remote attribution and account detail. Runs its own zero-dependency local service reading this machine's Magpie usage data; optional remote attribution queries the configured remote magpie.",
      "zh": "额度到期卡片墙 + 每日与 provider 用量图表 + 24 小时缓存命中与 token 曲线，可选远端归因与账号明细。自带零依赖本机服务，读本机 Magpie 用量数据；远端归因会查询所配置的远端 magpie。"
    },
    "page": {
      "title": "Usage Board",
      "titles": {
        "en": "Usage Board",
        "zh": "用量看板"
      },
      "file": "page/index.html",
      "icon": "page/icon.svg",
      "service": {
        "port": 3455
      }
    },
    "permissions": [],
    "icon": "data:image/svg+xml;base64,"
  },
  "devDependencies": {
    "echarts": "^5.5.1",
    "esbuild": "^0.28.2"
  }
}
