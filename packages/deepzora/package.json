{
  "name": "@magpie-community/agent-deepzora",
  "version": "0.1.0",
  "description": "Deepzora Desktop, CLI and ACP as a Magpie agent, with a reversible TOML and dotenv configuration bridge",
  "type": "module",
  "main": "./index.mjs",
  "files": [
    "index.mjs",
    "deepzora.agent.js",
    "bridge.mjs",
    "vendor.mjs",
    "cli.mjs",
    "README.md",
    "THIRD_PARTY.md",
    "LICENSE",
    "LICENSE-ICON",
    "ASSET_NOTICE.md",
    "LICENSE-DOTENV",
    "LICENSE-SMOL-TOML"
  ],
  "bin": {
    "magpie-deepzora": "./cli.mjs"
  },
