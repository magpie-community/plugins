{
  "name": "@magpie-community/frp-connect",
  "version": "0.3.0",
  "description": "A frpc tunnel to your own frp server: a page to set it up, and frpc started and stopped there, with a pinned and checksummed frpc.",
  "type": "module",
  "main": "./index.mjs",
  "files": [
    "index.mjs",
    "lib",
    "page",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test test/"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "magpie",
    "frp",
    "frpc",
    "tunnel",
    "reverse-proxy"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/magpie-community/plugins.git",
    "directory": "packages/frp-connect"
  },
  "magpie": {
    "name": "FRP Connect",
    "icon": "data:image/svg+xml;base64,",
    "page": {
      "title": "FRP Connect",
      "file": "page/index.html",
      "service": {
        "port": 33417,
        "option": "servicePort"
      },
      "titles": {
        "zh": "FRP 连接",
        "zh-TW": "FRP 連線",
        "ja": "FRP 接続"
      }
    },
    "options": {
      "frpcBinary": "download",
      "frpcPath": "",
      "autoStart": false,
      "servicePort": 0,
      "configMode": "form",
      "frpcToml": "",
      "serverAddr": "",
      "serverPort": 7000,
      "authMethod": "token",
      "authToken": "",
      "transport": "tcp",
      "proxies": []
    }
  }
}
