{
  "name": "@magpie-community/tools-frp-connect",
  "version": "0.2.0",
  "description": "Run and supervise frpc to expose local services (like magpie's gateway) through a FRP server, with on-demand frpc download for every platform.",
  "type": "module",
  "main": "./index.ts",
  "files": [
    "index.ts",
    "README.md",
    "page"
  ],
  "keywords": [
    "opencode",
    "opencode-plugin",
    "magpie",
    "frp",
    "frpc",
    "tunnel",
    "reverse-proxy"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/magpie-community/plugins.git",
    "directory": "packages/frp-connect"
  },
  "magpie": {
    "name": "FRP Connect",
    "icon": "data:image/svg+xml;base64,",
    "page": {
      "title": "FRP Connect",
      "file": "page/index.html",
      "titles": {
        "zh": "FRP 连接"
      }
    },
    "options": {
      "frpcPath": "",
      "frpcVersion": "latest",
      "frpcDownloadBase": "https://github.com/fatedier/frp/releases/download",
      "frpcMode": "download",
      "configMode": "form",
      "frpcToml": "",
      "autoConnect": false,
      "serverAddr": "",
      "serverPort": 7000,
      "authMethod": "token",
      "authToken": "",
      "transport": "tcp",
      "proxies": []
    }
  }
}
