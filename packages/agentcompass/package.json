{
  "name": "@magpie-community/gateway-agentcompass",
  "version": "0.1.4",
  "description": "Intent, multi-dimensional capability, Model DNA, subscription quota opportunity-cost, and session-affinity routing plugin for Magpie, powered by AgentCompass.",
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./server": "./src/index.js",
    "./hooks": "./src/hooks.js",
    "./middleware": "./src/middleware.js",
    "./allocator": "./src/allocator.js",
    "./continuity": "./src/continuity.js",
    "./quota": "./src/quota.js",
    "./profiler": "./src/profiler-core.js",
    "./catalog": "./src/catalog.js"
  },
  "magpie": {
    "name": "AgentCompass",
    "icon": "data:image/svg+xml;base64,",
    "middleware": "./src/middleware.js",
    "options": {
      "routeAllModels": false,
      "injectProtocolEffort": true
    }
  },
  "scripts": {
    "test": "node --test test/router.test.mjs"
  },
  "keywords": [
    "magpie",
    "magpie-middleware",
    "magpie-routing",
    "routing",
    "load-balancing",
    "llm-gateway",
    "agentcompass"
  ],
  "homepage": "https://github.com/akiiwa-games/AgentCompass",
  "repository": {
    "type": "git",
    "url": "https://github.com/magpie-community/plugins.git",
    "directory": "packages/agentcompass"
  },
  "license": "MIT"
}
