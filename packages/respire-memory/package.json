{
  "name": "@magpie-community/gateway-respire-memory",
  "version": "0.3.4",
  "description": "帮助 AI Agent 通过记忆召回、经验积累与后台归档持续自进化",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "magpie-plugin",
    "magpie",
    "respire",
    "memory"
  ],
  "files": [
    "respire.hooks.mjs",
    "runtime.mjs",
    "lock.mjs",
    "conversation.mjs",
    "page",
    "README.md",
    "LICENSE",
    "NOTICE",
    "state.mjs",
    "queue.mjs",
    "worker.mjs",
    "archive.mjs",
    "archive-context.mjs",
    "generation.mjs",
    "memory-tools.mjs",
    "policy.mjs"
  ],
  "engines": {
    "bun": ">=1.3.6"
  },
  "magpie": {
    "hooks": "./respire.hooks.mjs",
    "options": {
      "runtimeUrl": "http://127.0.0.1:15169",
      "project": "",
      "gatewayTimeoutMs": 5000,
      "requestTimeoutMs": 1500,
      "maxBytes": 8000,
      "limit": 3,
      "remember": true,
      "capture": false,
      "readOnly": false,
      "archive": true,
      "showMemoryStatus": false,
      "generationBaseUrl": "",
      "generationModel": "",
      "authorizationEnv": "RESPIRE_MAGPIE_AUTHORIZATION",
      "stateDir": ""
    },
    "page": {
      "title": "respire-memory",
      "file": "page/settings.html",
      "icon": "page/icon.svg"
    },
    "icon": "data:image/svg+xml;base64,"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/magpie-community/plugins.git",
    "directory": "packages/respire-memory"
  },
  "homepage": "https://github.com/risense-ai/respire-magpie#readme",
  "bugs": {
    "url": "https://github.com/risense-ai/respire-magpie/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "check": "node scripts/check.mjs"
  }
}
