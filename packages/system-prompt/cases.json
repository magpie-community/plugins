[
  { "name": "Anthropic: none is given this one",
    "options": { "system_prompt": "Be brief." },
    "request": { "model": "m", "messages": [] },
    "expect_request": { "model": "m", "messages": [], "system": "Be brief." } },
  { "name": "Anthropic: an agent's own stays without override",
    "options": { "system_prompt": "Be brief." },
    "request": { "model": "m", "system": "You code." } },
  { "name": "Anthropic: override appends a block after the cached ones",
    "options": { "system_prompt": "Be brief.", "override": true },
    "request": { "model": "m", "system": [{ "type": "text", "text": "You code.", "cache_control": { "type": "ephemeral" } }] },
    "expect_request": { "model": "m", "system": [{ "type": "text", "text": "You code.", "cache_control": { "type": "ephemeral" } }, { "type": "text", "text": "Be brief." }] } },
  { "name": "Anthropic: override prepends to a string, New API's way",
    "options": { "system_prompt": "Be brief.", "override": true, "position": "prepend" },
    "request": { "model": "m", "system": "You code." },
    "expect_request": { "model": "m", "system": "Be brief.\nYou code." } },
  { "name": "Chat: a system message first",
    "ctx": { "protocol": "chat" },
    "options": { "system_prompt": "Be brief." },
    "request": { "model": "m", "messages": [{ "role": "user", "content": "hi" }] },
    "expect_request": { "model": "m", "messages": [{ "role": "system", "content": "Be brief." }, { "role": "user", "content": "hi" }] } },
  { "name": "Chat: override on a developer message",
    "ctx": { "protocol": "chat" },
    "options": { "system_prompt": "Be brief.", "override": true },
    "request": { "model": "m", "messages": [{ "role": "developer", "content": "You code." }, { "role": "user", "content": "hi" }] },
    "expect_request": { "model": "m", "messages": [{ "role": "developer", "content": "You code.\nBe brief." }, { "role": "user", "content": "hi" }] } },
  { "name": "Chat: override appends to the last of several system messages",
    "ctx": { "protocol": "chat" },
    "options": { "system_prompt": "Be brief.", "override": true },
    "request": { "model": "m", "messages": [
      { "role": "system", "content": "You code." },
      { "role": "system", "content": "You verify." },
      { "role": "user", "content": "hi" }] },
    "expect_request": { "model": "m", "messages": [
      { "role": "system", "content": "You code." },
      { "role": "system", "content": "You verify.\nBe brief." },
