[
  { "name": "strip: a think block split across Chat chunks",
    "ctx": { "protocol": "chat", "stream": true },
    "events": [
      { "data": { "choices": [{ "index": 0, "delta": { "role": "assistant", "content": "<thi" } }] } },
      { "data": { "choices": [{ "index": 0, "delta": { "content": "nk>plan it" } }] } },
      { "data": { "choices": [{ "index": 0, "delta": { "content": " out</th" } }] } },
      { "data": { "choices": [{ "index": 0, "delta": { "content": "ink>\n\nHello" } }] } },
      { "data": { "choices": [{ "index": 0, "delta": { "content": " <think> stays" } }] } },
      { "data": { "choices": [{ "index": 0, "delta": {}, "finish_reason": "stop" }] } },
      { "data": "[DONE]" }],
    "expect_events": [
      { "choices": [{ "index": 0, "delta": { "role": "assistant", "content": "" } }] },
      { "choices": [{ "index": 0, "delta": { "content": "" } }] },
      { "choices": [{ "index": 0, "delta": { "content": "" } }] },
      { "choices": [{ "index": 0, "delta": { "content": "Hello" } }] },
      { "choices": [{ "index": 0, "delta": { "content": " <think> stays" } }] },
      { "choices": [{ "index": 0, "delta": {}, "finish_reason": "stop" }] },
      "[DONE]"] },
  { "name": "strip: text without a block passes untouched",
    "ctx": { "protocol": "chat", "stream": true },
    "events": [
      { "data": { "choices": [{ "index": 0, "delta": { "content": "a < b" } }] } },
      { "data": { "choices": [{ "index": 0, "delta": { "content": "<think>" } }] } }] },
  { "name": "strip: a stream that ends on held text gives it back",
    "ctx": { "protocol": "chat", "stream": true },
    "events": [
      { "data": { "choices": [{ "index": 0, "delta": { "content": "<" } }] } },
      { "data": { "choices": [{ "index": 0, "delta": {}, "finish_reason": "stop" }] } }],
    "expect_events": [
      { "choices": [{ "index": 0, "delta": { "content": "" } }] },
      { "choices": [{ "index": 0, "delta": { "content": "<" }, "finish_reason": "stop" }] }] },
  { "name": "strip: Anthropic text deltas",
    "events": [
      { "event": "content_block_delta", "data": { "type": "content_block_delta", "index": 0, "delta": { "type": "text_delta", "text": "<think>x</think>" } } },
      { "event": "content_block_delta", "data": { "type": "content_block_delta", "index": 0, "delta": { "type": "text_delta", "text": "\nDone." } } },
      { "event": "content_block_delta", "data": { "type": "content_block_delta", "index": 1, "delta": { "type": "input_json_delta", "partial_json": "<think>" } } }],
    "expect_events": [
      { "type": "content_block_delta", "index": 0, "delta": { "type": "text_delta", "text": "" } },
      { "type": "content_block_delta", "index": 0, "delta": { "type": "text_delta", "text": "Done." } },
      { "type": "content_block_delta", "index": 1, "delta": { "type": "input_json_delta", "partial_json": "<think>" } }] },
  { "name": "strip: whole replies",
    "response": { "content": [{ "type": "text", "text": "<think>\nhmm\n</think>\n\nHi" }] },
    "expect_response": { "content": [{ "type": "text", "text": "Hi" }] } },
  { "name": "strip: a whole Chat reply",
    "ctx": { "protocol": "chat" },
    "response": { "choices": [{ "message": { "content": "<think>x</think>Hi" } }] },
    "expect_response": { "choices": [{ "message": { "content": "Hi" } }] } },
  { "name": "strip: a </think> in inline code is the thinking's words (#176)",
    "ctx": { "protocol": "chat", "stream": true },
    "events": [
      { "data": { "choices": [{ "index": 0, "delta": { "content": "<think>开始分析。使用 `<think>...</th" } }] } },
      { "data": { "choices": [{ "index": 0, "delta": { "content": "ink>` 标签。\n继续分析。</th" } }] } },
      { "data": { "choices": [{ "index": 0, "delta": { "content": "ink>\n最终正文。" } }] } }],
    "expect_events": [
      { "choices": [{ "index": 0, "delta": { "content": "" } }] },
      { "choices": [{ "index": 0, "delta": { "content": "" } }] },
      { "choices": [{ "index": 0, "delta": { "content": "最终正文。" } }] }] },
  { "name": "strip: a whole reply's close in inline code (#176)",
    "ctx": { "protocol": "chat" },
    "response": { "choices": [{ "message": { "content": "<think>开始分析。使用 `<think>...</think>` 标签。\n继续分析。</think>\n最终正文。" } }] },
    "expect_response": { "choices": [{ "message": { "content": "最终正文。" } }] } },
  { "name": "to_content: reasoning_content into the text",
    "ctx": { "protocol": "chat", "stream": true },
    "options": { "mode": "to_content" },
    "events": [
      { "data": { "choices": [{ "index": 0, "delta": { "role": "assistant", "reasoning_content": "Let me" } }] } },
      { "data": { "choices": [{ "index": 0, "delta": { "reasoning_content": " see." } }] } },
      { "data": { "choices": [{ "index": 0, "delta": { "content": "Hi" } }] } },
      { "data": { "choices": [{ "index": 0, "delta": { "content": "!" }, "finish_reason": "stop" }] } }],
    "expect_events": [
      { "choices": [{ "index": 0, "delta": { "role": "assistant", "content": "<think>\nLet me" } }] },
      { "choices": [{ "index": 0, "delta": { "content": " see." } }] },
      { "choices": [{ "index": 0, "delta": { "content": "\n</think>\n\nHi" } }] },
      { "choices": [{ "index": 0, "delta": { "content": "!" }, "finish_reason": "stop" }] }] },
  { "name": "to_content: a whole reply",
    "ctx": { "protocol": "chat" },
    "options": { "mode": "to_content" },
    "response": { "choices": [{ "message": { "role": "assistant", "reasoning_content": "hmm", "content": "Hi" } }] },
    "expect_response": { "choices": [{ "message": { "role": "assistant", "content": "<think>\nhmm\n</think>\n\nHi" } }] } }
]
