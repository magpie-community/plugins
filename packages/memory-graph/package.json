{
  "name": "@magpie-community/page-memory-graph",
  "version": "0.2.0",
  "description": "Obsidian-style memory graph for magpie powered by local cosine similarity (magpie's built-in multilingual vectors + zero-dependency TF-IDF fallback). Read-only, zero external dependencies, instant build.",
  "type": "module",
  "main": "./index.mjs",
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "author": "pzjyyds666 (https://github.com/pzjyyds666)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/magpie-community/plugins.git",
    "directory": "packages/memory-graph"
  },
  "bugs": {
    "url": "https://github.com/magpie-community/plugins/issues"
  },
  "keywords": [
    "magpie",
    "magpie-plugin",
    "magpie-page",
    "memory",
    "graph",
    "obsidian",
    "memory-search"
  ],
  "files": [
    "index.mjs",
    "lib",
    "page",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "magpie": ">=0.1.1340"
  },
  "magpie": {
    "name": "记忆图谱",
    "icon": "data:image/svg+xml;base64,",
    "summary": {
      "en": "Draws your magpie memories as an Obsidian-style graph linked by true semantic cosine similarity (reusing magpie's local multilingual vectors with zero-dep TF-IDF fallback). Live similarity threshold slider, superseded lineage edges, read-only.",
      "zh": "把 magpie 记忆画成 Obsidian 风格关系图谱：直接复用 magpie 本地多语言向量计算精确余弦相似度（缺失时自动词法+标签回退），支持 0.35~0.90 实时相似度阈值滑块与已取代演进连线，纯本地只读毫秒级出图。"
    },
    "page": {
      "title": "Memory Graph",
      "titles": {
        "zh": "记忆图谱",
        "zh-TW": "記憶圖譜",
        "en": "Memory Graph"
      },
      "file": "page/index.html",
      "icon": "page/icon.svg",
      "keepAlive": true,
      "service": {
        "port": 3491,
        "option": "port"
      }
    },
    "options": {
      "port": 3491,
      "minSimilarity": 0.6,
      "maxNodes": 1000,
      "idleMinutes": 5
    },
    "permissions": []
  }
}
