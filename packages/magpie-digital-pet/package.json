{
  "name": "@magpie-community/page-digital-pet",
  "version": "0.6.0",
  "description": "A virtual pet page for the magpie gateway: routed usage feeds the active partner, with local care, expeditions and collections. Depends on @jcendal/opencode-digital-pet 0.18.0; this package bundles no sprite art. Polls magpie's own usage API; never touches agents' contexts.",
  "type": "module",
  "main": "./index.mjs",
  "files": [
    "index.mjs",
    "lib",
    "cli",
    "page",
    "ui",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "keywords": [
    "magpie",
    "magpie-plugin",
    "magpie-page",
    "opencode",
    "opencode-plugin",
    "virtual-pet"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/magpie-community/plugins.git",
    "directory": "packages/magpie-digital-pet"
  },
  "bugs": {
    "url": "https://github.com/magpie-community/plugins/issues"
  },
  "homepage": "https://github.com/manjughosa/magpie-digital-pet#readme",
  "engines": {
    "magpie": ">=0.1.1340"
  },
  "dependencies": {
    "@jcendal/opencode-digital-pet": "0.18.0"
  },
  "magpie": {
    "icon": "page/icon.svg",
    "page": {
      "title": "Digital Pet",
      "file": "page/index.html",
      "icon": "page/icon.svg",
      "service": {
        "port": 3571,
        "option": "port"
      },
      "titles": {
        "zh": "宠物",
        "zh-TW": "寵物",
        "ja": "デジペット"
      }
    },
    "panels": [
      {
        "slot": "settings",
        "title": "Digital Pet",
        "file": "ui/panel.html"
      }
    ],
    "options": {
      "enabled": true,
      "notifications": true,
      "includeCacheTokens": false,
      "backfill": false,
      "pollSeconds": 60,
      "gatewayUrl": "http://127.0.0.1:3425",
      "dbPath": "",
      "port": 3571
    },
    "permissions": []
  }
}
