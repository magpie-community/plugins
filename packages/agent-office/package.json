{
  "name": "@magpie-community/page-agent-office",
  "version": "0.1.0",
  "description": "我的 Agent 在干嘛：实时读取 Claude Code、Codex、DeepSeek Harness、Gemini CLI 等 Agent 自己的会话文件，把每个会话画成方块太空站办公室里的小人（3D/2D）或列表。What are my agents doing, live, from each agent's own session files.",
  "type": "module",
  "files": [
    "page/index.html",
    "page/style.css",
    "page/agents.js",
    "page/model.js",
    "page/icons.js",
    "page/scene.js",
    "page/app.js",
    "page/icon.svg",
    "page/icons",
    "lib",
    "docs",
    "office.hooks.mjs",
    "CHANGELOG.md",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "magpie",
    "magpie-plugin",
    "magpie-page",
    "agents",
    "status",
    "office",
    "dashboard",
    "opencode"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/magpie-community/plugins.git",
    "directory": "packages/agent-office"
  },
  "bugs": {
    "url": "https://github.com/magpie-community/plugins/issues"
  },
  "homepage": "https://github.com/magpie-community/plugins/tree/main/packages/agent-office#readme",
  "engines": {
    "magpie": ">=0.1.1318"
  },
  "scripts": {
    "test": "bun test"
  },
  "magpie": {
    "page": {
      "title": "Agent Office",
      "titles": {
        "zh": "Agent 办公室",
        "zh-TW": "Agent 辦公室",
        "ja": "エージェントオフィス",
        "de": "Agent-Büro"
      },
      "file": "page/index.html",
      "icon": "page/icon.svg"
    },
    "hooks": "./office.hooks.mjs",
    "permissions": [],
    "options": {
      "mode": "office",
      "dim": "3d",
      "demo": false,
      "showDone": true,
      "hideAfter": "6h",
      "text": true,
      "remote": false
    }
  }
}
