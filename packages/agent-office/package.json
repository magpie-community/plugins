{
  "name": "@magpie-community/page-agent-office",
  "version": "0.2.1",
  "description": "我的 Agent 在干嘛：读取本机 Claude Code、Codex、Copilot CLI、Kimi Code、DeepSeek Harness、Gemini CLI、Qwen Code、Pi、omp、Qoder、WorkBuddy、CodeBuddy、Grok Build 的会话文件，把每个会话画成真 3D / 等距 / 2D 办公室里的小人，或分组工作台。Live agent activity dashboard for magpie, with a real WebGL office and six scenes.",
  "type": "module",
  "files": [
    "page/index.html",
    "page/style.css",
    "page/agents.js",
    "page/model.js",
    "page/icons.js",
    "page/scene.js",
    "page/app.js",
    "page/icon.svg",
    "page/scene3d.js",
    "page/three.min.js",
    "page/icons",
    "lib",
    "office.hooks.mjs",
    "CHANGELOG.md",
    "README.md",
    "LICENSE",
    "bin",
    "SKILL.md"
  ],
  "keywords": [
    "magpie",
    "magpie-plugin",
    "magpie-page",
    "agents",
    "status",
    "office",
    "dashboard",
    "opencode",
    "3d",
    "threejs",
    "webgl",
    "scenes"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/magpie-community/plugins.git",
    "directory": "packages/agent-office"
  },
  "bugs": {
    "url": "https://github.com/magpie-community/plugins/issues"
  },
  "homepage": "https://github.com/magpie-community/plugins/tree/main/packages/agent-office#readme",
  "engines": {
    "magpie": ">=0.1.1318"
  },
  "scripts": {
    "test": "bun test"
  },
  "magpie": {
    "page": {
      "title": "Agent Office",
      "titles": {
        "zh": "Agent 办公室",
        "zh-TW": "Agent 辦公室",
        "ja": "エージェントオフィス",
        "de": "Agent-Büro"
      },
      "file": "page/index.html",
      "icon": "page/icon.svg"
    },
    "hooks": "./office.hooks.mjs",
    "permissions": [],
    "options": {
      "mode": "office",
      "dim": "3d",
      "demo": false,
      "showDone": true,
      "hideAfter": "6h",
      "text": true,
      "remote": false,
      "scene": "office",
      "quality": "medium",
      "agents": [],
      "showSub": true,
      "showIdle": true,
      "side": false,
      "lang": "auto"
    }
  },
  "bin": {
    "agent-office": "bin/agent-office.mjs"
  }
}
