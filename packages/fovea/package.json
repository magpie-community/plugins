{
  "name": "@magpie-community/middleware-fovea",
  "version": "0.2.6",
  "description": "magpie gateway middleware: keep the recent window sharp, thin old history to head and tail, and on a saccade drop the old context on a new topic — with an evidence page",
  "type": "module",
  "files": [
    "CHANGELOG.md",
    "LICENSE",
    "README.md",
    "benchmark.mjs",
    "build.mjs",
    "cases.json",
    "fovea.middleware.js",
    "fovea.protocols.test.mjs",
    "fovea.test.mjs",
    "page/*",
    "preview.mjs",
    "state-block.example.json"
  ],
  "keywords": [
    "magpie",
    "magpie-middleware",
    "context",
    "history",
    "compaction",
    "tool-results",
    "token-budget",
    "saccade",
    "llm-gateway"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/magpie-community/plugins.git",
    "directory": "packages/fovea"
  },
  "magpie": {
    "middleware": "./fovea.middleware.js",
    "page": {
      "title": "Fovea evidence",
      "titles": {
        "zh": "Fovea 对照证据"
      },
      "file": "page/index.html",
      "icon": "page/icon.svg"
    },
    "permissions": [],
    "options": {
      "threshold": 96000,
      "keep_recent": 12,
      "keep_recent_tokens": 16000,
      "tool_head": 600,
      "tool_tail": 300,
      "text_head": 1200,
      "text_tail": 400,
      "drop_old_images": true,
      "protect": [],
      "saccade": "off",
      "state_marker": "",
      "cut_step": 24
    },
    "icon": "data:image/svg+xml;base64,"
  }
}
