{
  "name": "@magpie-community/opencode-quwork-auth",
  "version": "0.1.0",
  "description": "Unofficial QuWork (Clawork) provider for OpenCode and magpie: browser phone+SMS sign-in with Aliyun captcha, or the desktop client's saved session, with live models, points balance and a setup page",
  "type": "module",
  "main": "./opencode.mjs",
  "exports": {
    ".": "./opencode2.mjs"
  },
  "files": [
    "index.mjs",
    "opencode.mjs",
    "opencode2.mjs",
    "README.md",
    "LICENSE",
    "page"
  ],
  "keywords": [
    "opencode",
    "opencode-plugin",
    "magpie",
    "quwork",
    "qurwork",
    "clawork"
  ],
  "license": "MIT",
  "scripts": {
    "test": "node --test"
  },
  "magpie": {
    "name": "QuWork",
    "summary": {
      "en": "Unofficial QuWork (Clawork) access: browser sign-in with phone and SMS (Aliyun captcha), or the desktop client's saved session; live models, points balance and a setup page.",
      "zh": "非官方 QuWork（Clawork）接入：浏览器手机验证码登录（阿里云验证码），或复用桌面端登录态；动态模型、积分余额与接入页。"
    },
    "icon": "data:image/svg+xml;base64,",
    "page": {
      "title": "QuWork 接入",
      "file": "page/index.html",
      "titles": {
        "zh": "QuWork 接入",
        "en": "QuWork setup"
      }
    },
    "permissions": [
      "providers:list"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/magpie-community/plugins.git",
    "directory": "packages/quwork"
  }
}
